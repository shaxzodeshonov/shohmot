# Shohmot's settings. On Vercel, set these in Project → Settings → Environment
# Variables. Locally, none are needed: accounts go to data/store.json and
# emails are printed to the console (and saved in data/outbox/).

# ---- Needed to launch ----

# The site's public address, used in emails, canonical links and the sitemap.
SITE_URL=https://your-domain.com

# Database (Upstash Redis): make a free one at console.upstash.com and copy
# the REST URL and token from its "REST API" section. (Vercel's KV_REST_API_*
# names, or a prefixed version, also work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email through Resend (resend.com, free for 3,000 a month). Verify your
# domain there first; MAIL_FROM must use it.
RESEND_API_KEY=
MAIL_FROM="Shohmot <hello@your-domain.com>"

# Any long random string (e.g. `openssl rand -hex 32`). Signs the unsubscribe
# links in emails, so they keep working across deploys.
SHOHMOT_SECRET=

# Vercel sends this with its daily call to /api/cron (the weekly recap).
# Any long random string.
CRON_SECRET=

# Your email(s), comma separated: they can open /admin.html.
ADMIN_EMAILS=you@example.com
# A ready-made login: the first sign-in with an ADMIN_EMAILS address and this
# password creates the account (no sign-up). Change it in Settings after.
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Shown on the legal pages and in the footer (read at build time).
PUBLIC_SUPPORT_EMAIL=support@your-domain.com
PUBLIC_OPERATOR_NAME="Your name or company"
PUBLIC_GOVERNING_LAW="Uzbekistan"

# ---- Later: paid plans ----
# Leave these empty and everything is free for everyone. Setting the first
# two switches the plans on (Pro features need Pro, Coach needs Coach).
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_COACH=
STRIPE_WEBHOOK_SECRET=
# Prices as shown on the site, and used for the admin page's revenue estimate.
PUBLIC_PRICE_PRO=5
PUBLIC_PRICE_COACH=19
PRICE_PRO_MONTHLY=5
PRICE_COACH_MONTHLY=19
# Friends and testers who get Pro free once plans are on.
COMP_EMAILS=
