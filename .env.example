# Shohmot's settings. On Vercel, set these in Project → Settings → Environment
# Variables. Locally, none are needed: accounts go to data/store.json and
# emails are printed to the console (and saved in data/outbox/).

# ---- Needed to launch ----

# The site's public address, used in emails, canonical links and the sitemap.
SITE_URL=https://your-domain.com

# Database (Upstash Redis): make a free one at console.upstash.com and copy
# the REST URL and token from its "REST API" section. (Vercel's KV_REST_API_*
# names, or a prefixed version, also work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email: password resets, confirmations and the weekly recap. Pick one.
# a) Gmail, no domain needed (about 500 a day): turn on 2-Step Verification,
#    make an app password at myaccount.google.com/apppasswords, and paste it.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# b) Resend (resend.com), once you have a domain verified there.
RESEND_API_KEY=
MAIL_FROM="Shohmot <hello@your-domain.com>"
# c) Any SMTP server (e.g. Brevo): host, port 465 or 587, login.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Any long random string (e.g. `openssl rand -hex 32`). Signs the unsubscribe
# links in emails, so they keep working across deploys.
SHOHMOT_SECRET=

# Vercel sends this with its daily call to /api/cron (the weekly recap).
# Any long random string.
CRON_SECRET=

# Your email(s), comma separated: they can open /admin.html.
ADMIN_EMAILS=you@example.com
# A ready-made login: the first sign-in with an ADMIN_EMAILS address and this
# password creates the account (no sign-up). Change it in Settings after.
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Shown on the legal pages and in the footer (read at build time).
PUBLIC_SUPPORT_EMAIL=support@your-domain.com
PUBLIC_OPERATOR_NAME="Your name or company"
PUBLIC_GOVERNING_LAW="Uzbekistan"

# ---- Later: paid plans ----
# Leave these empty and everything is free for everyone. Setting the first
# two switches the plans on (Pro features need Pro, Coach needs Coach).
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_COACH=
STRIPE_WEBHOOK_SECRET=
# Prices as shown on the site, and used for the admin page's revenue estimate.
PUBLIC_PRICE_PRO=5
PUBLIC_PRICE_COACH=19
PRICE_PRO_MONTHLY=5
PRICE_COACH_MONTHLY=19
# Friends and testers who get Pro free once plans are on.
COMP_EMAILS=

# ---- Fischer, the AI coach in game reviews (optional) ----
# An Anthropic API key (console.anthropic.com) turns on Fischer's AI coaching.
# Without it, Fischer still greets you and steps through the key moments, with no AI.
ANTHROPIC_API_KEY=
# The Claude model Fischer uses. Default: claude-opus-5-5 ($4 / $20 per million
# input / output tokens). claude-haiku-5-5 is far cheaper ($0.10 / $0.50).
FIL_MODEL=
# Messages a day for the whole site (default 2000), and per visitor an hour (default 40).
FIL_DAILY_LIMIT=
FIL_HOURLY_LIMIT=

# ---- Fischer's own voice (optional) ----
# Your ElevenLabs API key (elevenlabs.io -> your profile -> API keys) switches on
# a real man's voice for the coach; without it the coach uses the browser's
# built-in speech.
ELEVENLABS_API_KEY=
# The voice. Default: Brian, one of ElevenLabs' own voices (a deep American man).
# Paste any voice id from your ElevenLabs account to change it. To clone a voice
# instead, `node scripts/clone-voice.mjs` makes one from data/coach-voice-sample.mp3
# and prints its id: only clone a voice you have the right to use.
COACH_VOICE_ID=
# Who hears it: emails, comma-separated, or * for every signed-in account.
# Default: the ADMIN_EMAILS. Every line spoken costs characters on the ElevenLabs plan.
COACH_VOICE_EMAILS=
# Default eleven_multilingual_v2 (the most natural). eleven_flash_v2_5 is quicker and half the price.
COACH_VOICE_MODEL=
# Lines an hour per account (default 150), and characters a day for the whole site (default 150000).
COACH_VOICE_HOURLY_LIMIT=
COACH_VOICE_DAILY_CHARS=
