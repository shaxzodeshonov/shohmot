---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import '../styles/pages.css';
---
<Base title="Your students · Shohmot" description="See every student's games, losses and progress in one place." guard>
  <AppBar current="coach" />
  <main id="main" class="page wide-page coach">
    <h1 class="page-title">Your students</h1>
    <p class="muted">Every student’s games this week, with losses and rating changes. Open any game for a full review.</p>
    <div class="banners" id="banners" aria-live="polite"></div>

    <section class="bz-scan" aria-labelledby="c-invite-h" id="invite-box">
      <div class="bz-scan-top">
        <h2 id="c-invite-h">Invite link</h2>
        <button class="btn" type="button" id="c-new" disabled>New link</button>
      </div>
      <div class="c-invite">
        <input id="c-link" readonly aria-label="Invite link" placeholder="Loading…">
        <button class="btn btn-solid" type="button" id="c-copy" disabled>Copy</button>
      </div>
      <p class="muted small" id="c-seats">Send it to your students. When they open it signed in to Shohmot and say yes, they show up here. A new link stops the old one working; students who already joined stay.</p>
    </section>

    <section aria-labelledby="c-list-h">
      <h2 class="sec-h" id="c-list-h">This week</h2>
      <div class="c-table-wrap" tabindex="0" role="region" aria-label="Students table, scrolls sideways">
        <table class="c-table" id="c-table">
          <thead><tr><th>Student</th><th>Today</th><th>This week</th><th>Lost</th><th>Rating</th><th>Last game</th><th><span class="sr-only">Remove</span></th></tr></thead>
          <tbody id="c-rows"><tr><td colspan="7" class="muted">Loading…</td></tr></tbody>
        </table>
      </div>
    </section>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </main>
  <script>import '../scripts/coach.js';</script>
</Base>
