---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import '../styles/site.css';
---
<Base title="Create your account · Shohmot" description="Make a free Shohmot account to follow your Chess.com and Lichess games." bodyClass="auth-page">
  <header class="auth-top">
    <a class="wordmark" href="/"><Logo /> Shohmot</a>
  </header>

  <main class="auth-main">
      <div class="auth-card">
        <h1>Create your account</h1>
        <p>It’s free. Your chess accounts and settings follow you to any device.</p>
  
        <form id="auth-form" data-mode="register" novalidate>
          <label class="field">
            <span class="field-label">Your name <small>What Shohmot calls you</small></span>
            <input name="name" type="text" autocomplete="name" maxlength="40" required placeholder="e.g. Shaxzod">
          </label>
          <label class="field">
            <span class="field-label">Email</span>
            <input name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com" autocapitalize="none" spellcheck="false">
          </label>
          <div class="field">
            <label class="field-label" for="password">Password <small>At least 8 characters</small></label>
            <div class="field-input">
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
              <button type="button" class="pw-toggle" data-reveal="password" aria-pressed="false">Show</button>
            </div>
          </div>
          <button type="submit" class="btn btn-solid btn-lg auth-submit">Create account</button>
          <p class="auth-status" id="auth-status" aria-live="polite"></p>
        </form>
  
        <p class="auth-switch">Already have an account? <a href="/login.html" data-keep-next>Sign in</a></p>
        <p class="auth-note">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z" fill="currentColor"/></svg>
          Your password is salted and hashed with scrypt before it’s stored. Nobody, us included, can read it.
        </p>
      </div>
    </main>

  <script>import '../scripts/auth.js';</script>
</Base>
