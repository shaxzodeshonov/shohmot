---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import '../styles/site.css';
---
<Base title="Confirm your email · Shohmot" description="Confirm the email address on your Shohmot account." bodyClass="auth-page" noindex>
  <header class="auth-top">
    <a class="wordmark" href="/"><Logo /> Shohmot</a>
  </header>
  <main class="auth-main">
    <div class="auth-card" id="acct-form" data-mode="verify">
      <h1 id="verify-title">Confirming your email…</h1>
      <p class="auth-status" id="auth-status" aria-live="polite" data-kind="busy">One moment.</p>
      <p class="auth-switch"><a href="/app.html" class="btn btn-solid btn-lg" id="verify-next" hidden>Open Shohmot</a></p>
    </div>
  </main>
  <script>import '../scripts/account-forms.js';</script>
</Base>
