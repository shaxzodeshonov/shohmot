---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import '../styles/site.css';
---
<Base title="Choose a new password · Shohmot" description="Set a new password for your Shohmot account." bodyClass="auth-page" noindex>
  <header class="auth-top">
    <a class="wordmark" href="/"><Logo /> Shohmot</a>
  </header>
  <main class="auth-main">
    <div class="auth-card">
      <h1>Choose a new password</h1>
      <p>Once it’s set, you’re signed in here and signed out everywhere else.</p>
      <form id="acct-form" data-mode="reset" novalidate>
        <div class="field">
          <label class="field-label" for="password">New password <small>At least 8 characters</small></label>
          <div class="field-input">
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
            <button type="button" class="pw-toggle" data-reveal="password" aria-pressed="false">Show</button>
          </div>
        </div>
        <button type="submit" class="btn btn-solid btn-lg auth-submit">Save and sign in</button>
        <p class="auth-status" id="auth-status" aria-live="polite"></p>
      </form>
      <p class="auth-switch">Link expired? <a href="/forgot.html">Get a new one</a></p>
    </div>
  </main>
  <script>import '../scripts/account-forms.js';</script>
</Base>
