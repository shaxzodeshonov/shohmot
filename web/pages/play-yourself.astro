---
// Play against your own double: built from your public games, no account needed.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import '../styles/review.css';
import '../styles/pages.css';
---
<Base title="Play against yourself · Shohmot" description="Put in your Lichess or Chess.com username: Shohmot learns your openings and style from your games and builds a chess double of you to play against. Free, no account needed.">
  <header class="bar app-bar">
    <a class="wordmark" href="/"><Logo /> Shohmot</a>
    <nav class="app-nav" aria-label="Sections">
      <a href="/app.html" data-signed-in>Counter</a>
      <a href="/train.html" data-signed-in data-astro-prefetch="false">Training</a>
      <a href="/review.html" data-astro-prefetch="false">Game review</a>
      <a href="/play-yourself.html" aria-current="page">Play yourself</a>
    </nav>
    <div class="bar-actions">
      <a class="btn" href="/login.html" data-signed-out>Sign in</a>
      <a class="btn btn-solid" href="/signup.html" data-signed-out>Create free account</a>
    </div>
  </header>

  <main id="main" class="page wide-page double">
    <!-- The pitch: you against a robot of you. The pods are the cloning lab
         (lab.mjs): your avatar is scanned and the double is cast from it. -->
    <section class="py-hero" id="py-intro">
      <h1 class="py-title">Can you beat <em>yourself?</em></h1>
      <p class="py-lead">Shohmot reads your recent games and builds a robot that opens like you, plays at your rating and makes your kind of mistakes. Then you sit down against it.</p>

      <div class="lab" id="py-lab" role="group" aria-label="You and your double"></div>

      <form class="py-form" id="py-form">
        <label class="py-site"><span class="sr-only">Site</span>
          <select id="py-site"><option value="lichess">Lichess</option><option value="chesscom">Chess.com</option></select>
        </label>
        <input id="py-user" placeholder="Your username" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="30" required aria-label="Username">
        <button class="btn btn-solid btn-lg" type="submit" id="py-go">Build my double</button>
      </form>
      <p class="muted small" id="py-status" aria-live="polite">Free, and it runs in your browser. It only reads public games.</p>
      <div class="py-mine" id="py-mine" hidden></div>
      <!-- Nothing to type: see it work on players everyone knows (the demo's public accounts). -->
      <p class="py-mine py-try" id="py-try">
        <span class="muted small">Or meet a grandmaster’s double:</span>
        <button class="btn" type="button" data-p="chesscom" data-u="Hikaru">Hikaru</button>
        <button class="btn" type="button" data-p="chesscom" data-u="MagnusCarlsen">Magnus Carlsen</button>
        <button class="btn" type="button" data-p="lichess" data-u="DrNykterstein">DrNykterstein</button>
      </p>
      <p class="py-face" id="py-face"></p>
    </section>

    <ol class="py-steps" id="py-steps">
      <li><b>It reads your games</b>Up to 400 of your recent games, straight from Lichess or Chess.com.</li>
      <li><b>It casts your double</b>Your openings, how often you attack, castle and trade queens, and your rating.</li>
      <li><b>You play it</b>It answers with the moves you play, and slips the way players at your level do.</li>
    </ol>

    <!-- What the robot reports once it is switched on: its rating and how it plays. -->
    <section class="spec-panel" id="py-specs" hidden aria-label="Your double's rating and style"></section>

    <section class="py-profile" id="py-profile" hidden aria-labelledby="py-name"></section>

    <section class="tr-main py-play" id="py-play" hidden aria-label="Game against your double">
      <div class="tr-board-wrap">
        <div class="tr-who" id="py-top"></div>
        <div class="cb" id="board" role="img" aria-label="Board"></div>
        <div class="tr-who" id="py-bottom"></div>
      </div>
      <div class="tr-panel">
        <div class="py-setup" id="py-setup">
          <h2 class="tr-prompt">Play your double</h2>
          <div class="toggle" role="group" aria-label="Your colour" id="py-color">
            <button type="button" data-c="w" aria-pressed="true">White</button>
            <button type="button" data-c="b" aria-pressed="false">Black</button>
            <button type="button" data-c="r" aria-pressed="false">Random</button>
          </div>
          <button class="btn btn-solid btn-lg" type="button" id="py-start">Start</button>
        </div>
        <p class="tr-feedback" id="py-note" aria-live="polite"></p>
        <ol class="py-moves" id="py-moves"></ol>
        <div class="tr-actions">
          <button class="btn" type="button" id="py-resign" hidden>Resign</button>
          <button class="btn" type="button" id="py-new" hidden>New game</button>
          <a class="btn" id="py-review" hidden data-astro-prefetch="false">Review this game</a>
          <button class="btn" type="button" id="py-share" hidden>Challenge a friend</button>
        </div>
      </div>
    </section>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </main>
  <script>import '../scripts/double/page.js';</script>
</Base>
