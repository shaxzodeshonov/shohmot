---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import Counter from '../components/Counter.astro';
import '../styles/app.css';
---
<Base title="Shohmot" description="Today's games on each Chess.com and Lichess account: how many of each type you played, and how many you lost." guard>

  <AppBar current="counter">
    <p class="status" id="status" aria-live="polite" hidden><span class="status-dot"></span><span id="status-text">Connecting</span></p>
    <a class="btn" href="/analysis.html#setup" data-astro-prefetch="false">Set up position</a>
    <button class="btn" id="sync-now" type="button">Sync now</button>
    <button class="btn" id="open-accounts" type="button">Accounts</button>
  </AppBar>

  <Counter />

  <script>
  import '../scripts/popup.js';
  import '../scripts/app.js';
  </script>
</Base>
