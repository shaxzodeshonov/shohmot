---
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
import '../styles/review.css';
import ReviewPicker from '../components/ReviewPicker.astro';
import filPortrait from '../assets/fil.webp';

// Fischer's drawn frames, if they're in web/assets/fischer/ (made by
// scripts/fischer-frames.mjs): fischer-rest, -blink, -talk-1…5, and the moods.
// With rest and at least one talk frame, the face is the frames; otherwise the
// portrait with a drawn mouth.
const found = import.meta.glob('../assets/fischer/fischer-*.webp', { eager: true });
const frames = Object.entries(found).map(([file, mod]) => ({ name: file.replace(/^.*fischer-|\.webp$/g, ''), src: mod.default.src }));
const useFrames = frames.some((f) => f.name === 'rest') && frames.some((f) => f.name.startsWith('talk-'));
---
<Base title="Free chess game review · Shohmot" description="Paste a Lichess link or any PGN for a free Stockfish 19 game review: accuracy, every move labelled Brilliant to Blunder, the best moves and the evaluation graph. No account needed." bodyClass="rv-page">

  <header class="bar rv-bar">
    <a class="wordmark" href="/">
      <Logo />
      Shohmot
    </a>
    <!-- Phones: a back arrow, the page's name in the middle, search and settings on the right. -->
    <a class="rv-back" href="/app.html" data-signed-in aria-label="Back to games">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5m6-7-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a class="rv-back" href="/" data-signed-out aria-label="Home">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5m6-7-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <p class="rv-bar-title" aria-hidden="true">Game Review</p>
    <div class="bar-actions">
      <button class="rv-bar-btn rv-find" type="button" data-review-picker="user" aria-label="Review another game" title="Review another game">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
      <!-- Everything that isn't needed on every visit lives behind this one button. -->
      <details class="opts" id="opts">
        <summary class="icon-btn" aria-label="Settings" title="Settings">
          <svg class="i-sliders" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9m6 0h1M4 17h1m6 0h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="7" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="8" cy="17" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          <svg class="i-gear" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.3 3.6a1.7 1.7 0 0 1 3.4 0 1.7 1.7 0 0 0 2.6 1.1 1.7 1.7 0 0 1 2.4 2.4 1.7 1.7 0 0 0 1.1 2.6 1.7 1.7 0 0 1 0 3.4 1.7 1.7 0 0 0-1.1 2.6 1.7 1.7 0 0 1-2.4 2.4 1.7 1.7 0 0 0-2.6 1.1 1.7 1.7 0 0 1-3.4 0 1.7 1.7 0 0 0-2.6-1.1 1.7 1.7 0 0 1-2.4-2.4 1.7 1.7 0 0 0-1.1-2.6 1.7 1.7 0 0 1 0-3.4 1.7 1.7 0 0 0 1.1-2.6 1.7 1.7 0 0 1 2.4-2.4 1.7 1.7 0 0 0 2.6-1.1Z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.9"/></svg>
        </summary>
        <div class="opts-menu">
          <!-- On phones the bar has no room for these, so the menu holds them. -->
          <a class="btn opts-phone" href="/settings.html" data-signed-in>Account settings</a>
          <a class="btn opts-phone" href="/signup.html" data-signed-out>Create free account</a>
          <button class="btn opts-phone" type="button" id="flip-menu">Flip the board</button>
          <div class="opts-row"><span>Move sounds</span>
            <button class="icon-btn" id="sound" type="button" aria-pressed="true" aria-label="Move sounds">
              <svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2-3.7v7.4a4.5 4.5 0 0 0 2-3.7zM14.5 4.3v2.1a7 7 0 0 1 0 11.2v2.1a9 9 0 0 0 0-15.4z" fill="currentColor"/></svg>
              <svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z" fill="currentColor"/></svg>
            </button>
          </div>
          <label class="depth opts-row">
            <span>Sound style</span>
            <select id="sound-style"></select>
          </label>
          <label class="depth opts-row">
            <span>Engine</span>
            <select id="engine">
              <option value="full">Full (most accurate)</option>
              <option value="lite">Lite (faster)</option>
            </select>
          </label>
          <label class="depth opts-row">
            <span>Depth</span>
            <select id="depth">
              <option value="12">Quick · 12</option>
              <option value="16">Standard · 16</option>
              <option value="18" selected>Strong · 18</option>
              <option value="22">Deep · 22</option>
            </select>
          </label>
          <a class="btn" id="site-link" target="_blank" rel="noopener" hidden>Open on site</a>
          <a class="btn" id="to-analysis" href="/analysis.html" data-astro-prefetch="false" title="Open this position on the analysis board">Analysis board</a>
        </div>
      </details>
      <a class="btn" href="/app.html" data-signed-in>Back to games</a>
      <a class="btn btn-solid" href="/signup.html" data-signed-out>Create free account</a>
    </div>
  </header>

  <main id="main" class="review">
    <!-- The board sizes itself to this area (container query units, see review.css). -->
    <section class="rv-board" id="grid" aria-label="Board" hidden>
      <div class="stage">
        <div class="player top" id="player-top"></div>
        <div class="board-row">
          <div class="evalbar" id="evalbar" aria-hidden="true"><i></i><span></span></div>
          <div class="cb" id="board" role="img"></div>
        </div>
        <div class="player bottom" id="player-bottom"></div>
      </div>
    </section>

    <aside class="panel" aria-label="Review">
      <header class="panel-head">
        <h1 class="rv-title" id="title">Loading the game…</h1>
        <p class="rv-meta" id="meta"></p>
        <p class="rv-error" id="error" role="alert" hidden></p>
        <div class="rv-share" id="share-row" hidden>
          <button class="icon-btn rv-share-img" type="button" id="share" aria-label="Share image" title="Share image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4m0 0L8 8m4-4 4 4M5 12v6.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="icon-btn" type="button" id="copy-link" aria-label="Copy link" title="Copy link">
            <svg class="i-link" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="i-done" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </header>

      <!-- No game picked: paste one. -->
      <form class="paste" id="paste" hidden>
        <p class="muted">Free, in your browser, no account needed.</p>
        <label class="paste-field">
          <span>Lichess link or PGN</span>
          <textarea id="paste-text" rows="7" spellcheck="false" autocapitalize="none" placeholder="https://lichess.org/abcd1234&#10;&#10;or the whole PGN: [Event &quot;Live Chess&quot;] … 1. e4 e5 2. Nf3 …"></textarea>
        </label>
        <div class="paste-row">
          <label class="depth"><span>I played</span>
            <select id="paste-side"><option value="">Work it out</option><option value="w">White</option><option value="b">Black</option></select>
          </label>
          <button class="btn btn-solid" type="submit">Review this game</button>
        </div>
        <p class="rv-error" id="paste-error" role="alert" hidden></p>
        <p class="muted small-note">On Chess.com: open the game, press Share, choose PGN and copy it. <span data-signed-out>With a free account, every game you play is checked for mistakes on its own.</span></p>
        <div class="paste-alt">
          <span class="muted">Or:</span>
          <button class="btn" type="button" data-review-picker="user">Find it by your username</button>
          <button class="btn" type="button" data-review-picker="file">Open a PGN file</button>
        </div>
      </form>

      <div class="panel-game" id="panel-game" hidden>
        <!-- Everything above the move buttons. It scrolls as one only when the
             window is too short to give the tab underneath enough room. -->
        <div class="panel-scroll" id="panel-scroll">
        <!-- Fischer, the coach: talks you through each move. Its head moves with the move (data-mood). -->
        <section class="coach" id="coach" data-mood="thinking" data-frames={useFrames ? '' : undefined} aria-label="Coach">
          <!-- Fischer's portrait, with eyelids that blink and a mouth that moves while Fischer talks. -->
          <div class="coach-face" aria-hidden="true">
            {useFrames ? (
              <div class="fil-head">
                {frames.map((f) => <img class:list={['fil-frame', { on: f.name === 'rest' }]} data-f={f.name} src={f.src} alt="" width="256" height="256" decoding="async">)}
              </div>
            ) : (
              <div class="fil-head">
                <img src={filPortrait.src} alt="" width="256" height="256" decoding="async">
                <i class="fil-lid fil-lid-l"></i><i class="fil-lid fil-lid-r"></i>
                <!-- Drawn in the original image's pixel coordinates: skin over the
                     drawn lips, then a mouth whose lower half opens while Fischer talks. -->
                <svg class="fil-mouth" viewBox="628 356 136 64">
                  <defs>
                    <filter id="fil-soft" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="2.4"/></filter>
                    <clipPath id="fil-mouth-clip"><path d="M-50 0 Q0 6 50 0 Q30 30 0 32 Q-30 30 -50 0Z"/></clipPath>
                  </defs>
                  <ellipse class="fil-skin" cx="695" cy="387" rx="62" ry="23" transform="rotate(-5 695 387)" filter="url(#fil-soft)"/>
                  <!-- The mouth, level in its own frame (the line between the lips is y = 0), turned to the drawing's smile. -->
                  <g transform="translate(694.5 376) rotate(-4.6)"><g class="fil-lips">
                    <g class="fil-jaw">
                      <path class="fil-lowerlip" d="M-46 6 Q-28 34 0 36 Q28 34 46 4 Q30 44 0 46 Q-30 44 -46 6Z"/>
                      <path class="fil-hole" d="M-50 0 Q0 6 50 0 Q30 30 0 32 Q-30 30 -50 0Z"/>
                      <g clip-path="url(#fil-mouth-clip)">
                        <path class="fil-teeth" d="M-56 0 Q0 14 56 0 L56 8 Q0 22 -56 8Z"/>
                        <ellipse class="fil-tongue" cx="2" cy="31" rx="25" ry="10"/>
                      </g>
                      <path class="fil-rim" d="M-50 0 Q-30 30 0 32 Q30 30 50 0"/>
                    </g>
                    <path class="fil-upper" d="M-53 1 Q-27 -8 0 -4 Q27 -9 53 -1 Q26 5 0 4 Q-26 5 -53 1Z"/>
                  </g></g>
                </svg>
              </div>
            )}
            <span class="fil-dots"><i></i><i></i><i></i></span>
          </div>
          <div class="coach-bubble">
            <div class="coach-top">
              <b class="coach-name">Fischer</b><span class="coach-role">your coach</span>
              <button class="icon-btn coach-voice" id="coach-voice" type="button" aria-pressed="false" title="Read aloud (V)" hidden>
                <svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2-3.7v7.4a4.5 4.5 0 0 0 2-3.7zM14.5 4.3v2.1a7 7 0 0 1 0 11.2v2.1a9 9 0 0 0 0-15.4z" fill="currentColor"/></svg>
                <svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z" fill="currentColor"/></svg>
                <span class="sr-only">Read the coach aloud</span>
              </button>
            </div>
            <div class="note" id="note" aria-live="polite"></div>
            <p class="coach-tip" id="coach-tip" hidden></p>
            <!-- Phones: the review's share image, from the coach's card. -->
            <button class="coach-share" id="coach-share" type="button" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5.5" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="18.5" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m8.2 10.8 7.6-4.1m-7.6 6.5 7.6 4.1" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              Share
            </button>
          </div>
        </section>
        <div class="progress" id="progress" aria-live="polite">
          <p id="progress-text">Starting Stockfish…</p>
          <div class="progress-bar"><i id="progress-bar"></i></div>
        </div>

        <div class="graph" id="graph" aria-label="Evaluation over the game">
          <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path class="g-area" id="g-area"/><line class="g-mid" x1="0" y1="50" x2="1000" y2="50"/><line class="g-now" id="g-now" y1="0" y2="100"/></svg>
          <div class="g-dots" id="g-dots"></div>
        </div>


        <div class="tabbar">
        <div class="toggle" role="group" aria-label="View" id="tabs">
          <button type="button" data-tab="coach" aria-pressed="false">Coach</button>
          <button type="button" data-tab="report" aria-pressed="true">Report</button>
          <button type="button" data-tab="moves" aria-pressed="false">Moves</button>
        </div>
        </div>

        <div class="panel-body">
          <!-- Fischer, coaching you through the game (fil-chat.mjs). -->
          <div id="tab-coach" class="tab fil" hidden>
            <ol class="fil-log" id="fil-log" aria-label="Fischer, your coach"></ol>
            <p class="sr-only" id="fil-said" aria-live="polite"></p>
            <div class="fil-start" id="fil-start" hidden>
              <div class="fil-start-actions">
                <button class="btn btn-solid" id="fil-go" type="button" hidden>Coach me through it</button>
                <button class="btn" id="fil-tour" type="button">Step through the key moments</button>
              </div>
              <p class="fil-ai-note" id="fil-ai-note" hidden>Fischer’s coaching is written by Claude, an AI from Anthropic. When you start, this game’s moves and Stockfish’s notes on them are sent to answer you; nothing is kept. AI can make mistakes: Stockfish’s numbers are the ones to trust.</p>
            </div>
            <div class="fil-foot">
              <div class="fil-chips" id="fil-chips" hidden></div>
              <form class="fil-form" id="fil-form" hidden>
                <label class="sr-only" for="fil-input">Ask Fischer about this game</label>
                <input id="fil-input" type="text" maxlength="500" autocomplete="off" placeholder="Ask Fischer about this game">
                <button class="btn btn-solid" type="submit">Ask</button>
              </form>
            </div>
          </div>

          <div id="tab-report" class="tab">
            <div class="acc" id="acc"></div>
            <table class="counts" id="counts"></table>
            <h3 class="sub-h">By phase</h3>
            <table class="counts phase" id="phases"></table>
            <h3 class="sub-h">Your key moments</h3>
            <ul class="moments" id="moments"></ul>
          </div>

          <div id="tab-moves" class="tab" hidden>
            <section class="lines" id="lines" aria-label="Engine lines" aria-live="off">
              <div class="lines-h">
                <button type="button" class="switch" id="live-toggle" aria-pressed="true"><i></i><span>Engine</span></button>
                <small id="lines-depth"></small>
              </div>
              <div class="lines-body" id="lines-body"></div>
            </section>
            <ol class="moves" id="moves"></ol>
          </div>
        </div>

        </div>

        <!-- Phones: the move before, this move and the move after, under the board. -->
        <nav class="mstrip" id="mstrip" aria-label="Moves">
          <button class="mstrip-nav" data-go="prev" type="button" aria-label="Previous move">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="mstrip-moves" id="mstrip-moves"></div>
          <button class="mstrip-nav" data-go="next" type="button" aria-label="Next move">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </nav>

        <!-- Phones: the actions, in reach of the thumb at the bottom of the screen. -->
        <div class="actbar" id="actbar">
          <button class="act" id="act-show" type="button" aria-pressed="true" title="Show or hide the engine's arrow and lines">
            <svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            <svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 4l16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span>Show</span>
          </button>
          <button class="act" id="act-best" type="button" title="Play the best move here">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <span>Best</span>
          </button>
          <button class="act" id="act-skills" type="button" title="Your accuracy and moves, in the report">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <span>Skills</span>
          </button>
          <button class="act-next" data-go="next" type="button">Next</button>
        </div>

        <div class="controls">
          <button class="nav" data-go="start" type="button" aria-label="First move" title="First move (Home)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="nav" data-go="prev" type="button" aria-label="Previous move" title="Previous move (←)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="nav" data-go="next" type="button" aria-label="Next move" title="Next move (→)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="nav" data-go="end" type="button" aria-label="Last move" title="Last move (End)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn" id="next-bad" type="button" title="Your next inaccuracy, mistake, miss or blunder (N)">Next mistake</button>
          <button class="nav" id="flip" type="button" aria-label="Flip the board" title="Flip the board (F)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </aside>
  </main>

  <script>
  import '../scripts/review/review.mjs';
  </script>
  <ReviewPicker />
</Base>
