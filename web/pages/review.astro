---
import Base from '../layouts/Base.astro';
import '../styles/review.css';
import ReviewPicker from '../components/ReviewPicker.astro';
---
<Base title="Free chess game review · Shohmot" description="Paste a Lichess link or any PGN for a free Stockfish 19 game review: accuracy, every move labelled Brilliant to Blunder, the best moves and the evaluation graph. No account needed." bodyClass="rv-page">

  <header class="bar rv-bar">
    <a class="wordmark" href="/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8l-1-3.5c1.8-1.2 2.8-3.2 2.4-5.6-.4-2-1.8-3.4-3.4-4l.9-1.9-2-1-.8 1.6C9.6 6.8 7.5 8.9 7.5 11.7c0 1.4.6 2.7 1.6 3.6l-1.6 1 1 1.6 1.8-1L8 21z" fill="currentColor"/></svg>
      Shohmot
    </a>
    <div class="bar-actions">
      <button class="icon-btn" id="sound" type="button" aria-pressed="true" aria-label="Move sounds">
        <svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2-3.7v7.4a4.5 4.5 0 0 0 2-3.7zM14.5 4.3v2.1a7 7 0 0 1 0 11.2v2.1a9 9 0 0 0 0-15.4z" fill="currentColor"/></svg>
        <svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z" fill="currentColor"/></svg>
      </button>
      <label class="depth">
        <span>Engine</span>
        <select id="engine">
          <option value="full">Full (most accurate)</option>
          <option value="lite">Lite (faster)</option>
        </select>
      </label>
      <label class="depth">
        <span>Depth</span>
        <select id="depth">
          <option value="12">Quick · 12</option>
          <option value="16">Standard · 16</option>
          <option value="18" selected>Strong · 18</option>
          <option value="22">Deep · 22</option>
        </select>
      </label>
      <a class="btn" id="site-link" target="_blank" rel="noopener" hidden>Open on site</a>
      <a class="btn" id="to-analysis" href="/analysis.html" data-astro-prefetch="false" title="Open this position on the analysis board">Analysis board</a>
      <a class="btn" href="/app.html" data-signed-in>Back to games</a>
      <a class="btn btn-solid" href="/signup.html" data-signed-out>Create free account</a>
    </div>
  </header>

  <main id="main" class="review">
    <!-- The board sizes itself to this area (container query units, see review.css). -->
    <section class="rv-board" id="grid" aria-label="Board" hidden>
      <div class="stage">
        <div class="player top" id="player-top"></div>
        <div class="board-row">
          <div class="evalbar" id="evalbar" aria-hidden="true"><i></i><span></span></div>
          <div class="cb" id="board" role="img"></div>
        </div>
        <div class="player bottom" id="player-bottom"></div>
      </div>
    </section>

    <aside class="panel" aria-label="Review">
      <header class="panel-head">
        <h1 class="rv-title" id="title">Loading the game…</h1>
        <p class="rv-meta" id="meta"></p>
        <p class="rv-error" id="error" role="alert" hidden></p>
        <div class="rv-share" id="share-row" hidden>
          <button class="btn btn-solid" type="button" id="share">Share image</button>
          <button class="btn" type="button" id="copy-link">Copy link</button>
        </div>
      </header>

      <!-- No game picked: paste one. -->
      <form class="paste" id="paste" hidden>
        <p class="muted">Free, in your browser, no account needed.</p>
        <label class="paste-field">
          <span>Lichess link or PGN</span>
          <textarea id="paste-text" rows="7" spellcheck="false" autocapitalize="none" placeholder="https://lichess.org/abcd1234&#10;&#10;or the whole PGN: [Event &quot;Live Chess&quot;] … 1. e4 e5 2. Nf3 …"></textarea>
        </label>
        <div class="paste-row">
          <label class="depth"><span>I played</span>
            <select id="paste-side"><option value="">Work it out</option><option value="w">White</option><option value="b">Black</option></select>
          </label>
          <button class="btn btn-solid" type="submit">Review this game</button>
        </div>
        <p class="rv-error" id="paste-error" role="alert" hidden></p>
        <p class="muted small-note">On Chess.com: open the game, press Share, choose PGN and copy it. <span data-signed-out>With a free account, every game you play is checked for mistakes on its own.</span></p>
        <div class="paste-alt">
          <span class="muted">Or:</span>
          <button class="btn" type="button" data-review-picker="user">Find it by your username</button>
          <button class="btn" type="button" data-review-picker="file">Open a PGN file</button>
        </div>
      </form>

      <div class="panel-game" id="panel-game" hidden>
        <!-- Fil, the coach: talks you through each move. Its face follows the move (data-mood). -->
        <section class="coach" id="coach" data-mood="thinking" aria-label="Coach">
          <div class="coach-face" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <path class="c-mitre" d="M32 2.5c-3 2.4-4.4 4.8-4.4 7 0 2 1.5 3.5 4.4 3.5s4.4-1.5 4.4-3.5c0-2.2-1.4-4.6-4.4-7z"/>
              <path class="c-slit" d="M30.4 6.2 33.6 9.4"/>
              <rect class="c-neck" x="29" y="12.5" width="6" height="4" rx="1.5"/>
              <rect class="c-ear" x="5" y="28" width="6" height="12" rx="3"/>
              <rect class="c-ear" x="53" y="28" width="6" height="12" rx="3"/>
              <rect class="c-head" x="9" y="15.5" width="46" height="40" rx="13"/>
              <rect class="c-visor" x="15" y="22.5" width="34" height="23" rx="9"/>
              <g class="m m-calm"><circle cx="25" cy="32" r="3"/><circle cx="39" cy="32" r="3"/><path d="M28 39.5q4 2.5 8 0"/></g>
              <g class="m m-happy"><path d="M21.5 33q3.5-5 7 0M35.5 33q3.5-5 7 0"/><path d="M27 38.5q5 4.5 10 0"/></g>
              <g class="m m-wow"><path class="star" d="M25 27.5l1.3 3 3.2.3-2.4 2.1.7 3.2-2.8-1.7-2.8 1.7.7-3.2-2.4-2.1 3.2-.3zM39 27.5l1.3 3 3.2.3-2.4 2.1.7 3.2-2.8-1.7-2.8 1.7.7-3.2-2.4-2.1 3.2-.3z"/><ellipse cx="32" cy="40.5" rx="2.6" ry="2"/></g>
              <g class="m m-hmm"><path d="M21.5 31h7M35.5 30l7-1.5"/><path d="M28 40h8"/></g>
              <g class="m m-worried"><path d="M21.5 31.5l6.5-2.5M42.5 31.5l-6.5-2.5"/><circle cx="25" cy="34" r="2.2"/><circle cx="39" cy="34" r="2.2"/><path d="M27.5 41.5q4.5-3 9 0"/></g>
              <g class="m m-thinking"><circle cx="27" cy="30" r="2.6"/><circle cx="41" cy="30" r="2.6"/><path d="M28 40h6"/><circle class="dot" cx="38" cy="40" r="1"/><circle class="dot" cx="41" cy="40" r="1"/></g>
            </svg>
          </div>
          <div class="coach-bubble">
            <div class="coach-top">
              <b class="coach-name">Fil</b><span class="coach-role">your coach</span>
              <button class="icon-btn coach-voice" id="coach-voice" type="button" aria-pressed="false" title="Read aloud (V)" hidden>
                <svg class="on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.5 3a4.5 4.5 0 0 0-2-3.7v7.4a4.5 4.5 0 0 0 2-3.7zM14.5 4.3v2.1a7 7 0 0 1 0 11.2v2.1a9 9 0 0 0 0-15.4z" fill="currentColor"/></svg>
                <svg class="off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm12.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z" fill="currentColor"/></svg>
                <span class="sr-only">Read the coach aloud</span>
              </button>
            </div>
            <div class="note" id="note" aria-live="polite"></div>
            <p class="coach-tip" id="coach-tip" hidden></p>
          </div>
        </section>
        <div class="progress" id="progress" aria-live="polite">
          <p id="progress-text">Starting Stockfish…</p>
          <div class="progress-bar"><i id="progress-bar"></i></div>
        </div>

        <div class="graph" id="graph" aria-label="Evaluation over the game">
          <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path class="g-area" id="g-area"/><line class="g-mid" x1="0" y1="50" x2="1000" y2="50"/><line class="g-now" id="g-now" y1="0" y2="100"/></svg>
          <div class="g-dots" id="g-dots"></div>
        </div>

        <section class="lines" id="lines" aria-label="Engine lines" aria-live="off">
          <div class="lines-h">
            <button type="button" class="switch" id="live-toggle" aria-pressed="true"><i></i><span>Engine</span></button>
            <small id="lines-depth"></small>
          </div>
          <div class="lines-body" id="lines-body"></div>
        </section>

        <div class="toggle" role="group" aria-label="View" id="tabs">
          <button type="button" data-tab="report" aria-pressed="true">Report</button>
          <button type="button" data-tab="moves" aria-pressed="false">Moves</button>
        </div>

        <div class="panel-body">
          <div id="tab-report" class="tab">
            <div class="acc" id="acc"></div>
            <table class="counts" id="counts"></table>
            <h3 class="sub-h">By phase</h3>
            <table class="counts phase" id="phases"></table>
            <h3 class="sub-h">Your key moments</h3>
            <ul class="moments" id="moments"></ul>
          </div>

          <div id="tab-moves" class="tab" hidden>
            <ol class="moves" id="moves"></ol>
          </div>
        </div>

        <div class="controls">
          <button class="nav" data-go="start" type="button" aria-label="First move" title="First move (Home)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="nav" data-go="prev" type="button" aria-label="Previous move" title="Previous move (←)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="nav" data-go="next" type="button" aria-label="Next move" title="Next move (→)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="nav" data-go="end" type="button" aria-label="Last move" title="Last move (End)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="btn" id="next-bad" type="button" title="Your next inaccuracy, mistake, miss or blunder (N)">Next mistake</button>
          <button class="nav" id="flip" type="button" aria-label="Flip the board" title="Flip the board (F)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16m0 0-3-3m3 3 3-3M17 20V4m0 0-3 3m3-3 3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </aside>
  </main>

  <script>
  import '../scripts/review/review.mjs';
  </script>
  <ReviewPicker />
</Base>
