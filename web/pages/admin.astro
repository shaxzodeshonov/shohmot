---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import '../styles/pages.css';
---
<Base title="Admin · Shohmot" description="How Shohmot is doing." guard>
  <AppBar current="admin" />
  <main id="main" class="page wide-page admin">
    <div class="ad-head">
      <h1 class="page-title">How Shohmot is doing</h1>
      <label class="depth-pick">Range
        <select id="ad-days"><option value="7">7 days</option><option value="30" selected>30 days</option><option value="90">90 days</option></select>
      </label>
    </div>
    <p class="muted small">Counted on Shohmot’s own server, without cookies. Visitors are distinct per day, so the total adds up days.</p>
    <div class="banners" id="banners"></div>
    <dl class="ad-cards" id="ad-cards"></dl>
    <h2 class="sec-h">From visitor to regular</h2>
    <div class="ad-funnel" id="ad-funnel"></div>
    <h2 class="sec-h" id="ad-days-h">By day</h2>
    <div class="c-table-wrap" tabindex="0" role="region" aria-label="Days table, scrolls sideways"><table class="c-table ad-table" id="ad-days-table"></table></div>
    <div class="ad-two">
      <section><h2 class="sec-h">Pages</h2><table class="c-table" id="ad-pages"></table></section>
      <section><h2 class="sec-h">Features used</h2><table class="c-table" id="ad-events"></table></section>
    </div>
  </main>
  <script>import '../scripts/admin.js';</script>
</Base>
