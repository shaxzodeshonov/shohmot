---
import Logo from './Logo.astro';
interface Props { current?: string }
const { current } = Astro.props;
const here = (k: string) => (k === current ? 'page' : undefined);
---
<header class="site-bar">
  <div class="wrap">
    <a class="wordmark" href="/"><Logo /> Shohmot</a>
    <nav class="site-nav" aria-label="Site">
      <a href="/#features" aria-current={here('features')}>Features</a>
      <a href="/demo.html" data-astro-prefetch="false">Live demo</a>
      <a href="/review.html" data-astro-prefetch="false" aria-current={here('review-tool')}>Free game review</a>
      <a href="/play-yourself.html" data-astro-prefetch="false">Play yourself</a>
    </nav>
    <div class="site-actions">
      <a class="btn" href="/login.html" data-signed-out>Sign in</a>
      <a class="btn btn-solid" href="/signup.html" data-signed-out><span class="wide-only">Create account</span><span class="narrow-only">Sign up</span></a>
      <a class="btn btn-solid" href="/app.html" data-signed-in>Open Shohmot</a>
    </div>
  </div>
</header>
