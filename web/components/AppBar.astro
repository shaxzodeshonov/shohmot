---
// The top bar on the signed-in pages: the sections, an Upgrade button for
// free accounts (when paid plans are on), and who's signed in, which opens
// Settings. Page-specific buttons go in the default slot.
interface Props { current?: 'counter' | 'brilliants' | 'insights' | 'puzzles' | 'coach' | 'settings' | 'admin' }
const { current } = Astro.props;
const here = (k: string) => (k === current ? 'page' : undefined);
---
<header class="bar app-bar">
  <a class="wordmark" href="/app.html">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8l-1-3.5c1.8-1.2 2.8-3.2 2.4-5.6-.4-2-1.8-3.4-3.4-4l.9-1.9-2-1-.8 1.6C9.6 6.8 7.5 8.9 7.5 11.7c0 1.4.6 2.7 1.6 3.6l-1.6 1 1 1.6 1.8-1L8 21z" fill="currentColor"/></svg>
    Shohmot
  </a>
  <nav class="app-nav" aria-label="Sections">
    <a href="/app.html" aria-current={here('counter')}>Counter</a>
    <a href="/brilliants.html" aria-current={here('brilliants')} data-astro-prefetch="false">Brilliants</a>
    <a href="/insights.html" aria-current={here('insights')} data-astro-prefetch="false">Insights</a>
    <a href="/puzzles.html" aria-current={here('puzzles')} data-astro-prefetch="false">Puzzles</a>
    <a href="/analysis.html" data-astro-prefetch="false">Analysis</a>
    <a href="/coach.html" aria-current={here('coach')} data-astro-prefetch="false" data-for="coach" hidden>Students</a>
    <a href="/admin.html" aria-current={here('admin')} data-astro-prefetch="false" data-for="admin" hidden>Admin</a>
  </nav>
  <div class="bar-actions">
    <slot />
    <a class="btn btn-solid" href="/pricing.html" id="upgrade" hidden>Upgrade</a>
    <a class="me-chip" href="/settings.html" id="me" title="Settings and account" aria-current={here('settings')} hidden>
      <span class="me-av" id="me-av" aria-hidden="true"></span><span id="me-name"></span><span class="plan-badge" id="me-plan" hidden></span>
    </a>
  </div>
</header>
<script>import '../scripts/appbar.js';</script>
