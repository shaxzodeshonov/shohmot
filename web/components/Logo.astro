---
// The mark: a king tipping over on a sage tile ("shoh mot" is checkmate, the
// king is beaten). The king leans further when the wordmark is hovered
// (app.css); public/favicon.svg and the PNG icons are the same drawing.
---
<svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--sage)"/><g transform="translate(-2.1 .6)"><g class="logo-king" transform="rotate(16 16 25)" fill="var(--sage-ink)"><path d="M14.85 2.7h2.3v2.3h2.4v2.3h-2.4v2.5h-2.3V7.3h-2.4V5h2.4z"/><path d="M9.9 13Q16 11.6 22.1 13L19.9 20.6H12.1z" stroke="var(--sage-ink)" stroke-width="1.7" stroke-linejoin="round"/><rect x="8.5" y="23" width="15" height="3.5" rx="1.3"/></g></g></svg>
