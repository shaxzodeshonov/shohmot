---
// Every page: head, self-hosted font, page transitions, and a tiny inline
// script that knows before first paint whether the visitor is signed in.
// `guard` pages send signed-out visitors to sign in before anything draws.
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import fontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import '../styles/app.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  guard?: boolean;
  bodyClass?: string;
  /** Leave the page out of search engines (account pages). */
  noindex?: boolean;
}
const { title, description, guard = false, bodyClass, noindex = guard } = Astro.props;
const path = Astro.url.pathname.replace(/index\.html$/, '');
const canonical = `${SITE.url}${path === '/' ? '/' : path}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script is:inline define:vars={{ guard }}>
    var signedIn = document.cookie.split('; ').indexOf('shohmot_in=1') !== -1;
    document.documentElement.dataset.auth = signedIn ? 'in' : 'out';
    // How many chess accounts last visit's profile had: the counter keeps room for that many rows.
    if (signedIn) try { var me = JSON.parse(localStorage.getItem('shohmot-me')); if (me && me.accounts) document.documentElement.dataset.accounts = Math.min(4, me.accounts.length); } catch (e) {}
    if (guard && !signedIn) location.replace('/login.html?next=' + encodeURIComponent(location.pathname + location.search + location.hash));
  </script>
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Shohmot">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${SITE.url}/og.png`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1b140f">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin>
  <slot name="head" />
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
  <script>
  import '../scripts/track.js';
  import '../scripts/pwa.js';
  </script>
</body>
</html>
